# Optional source-evidence tools. Does not change the main CBM build.
# Run from the repository root: make -f Makefile.security test
CC ?= cc
PYTHON ?= python3
BUILD ?= build/security
SANITIZE ?=
CPPFLAGS += -Isrc -Isecurity -Iinternal/cbm -Ivendored/yyjson \
 -Iinternal/cbm/vendored/ts_runtime/include \
 -Iinternal/cbm/vendored/ts_runtime/src \
 -Iinternal/cbm/vendored/common
CFLAGS ?= -O2
SEC_FLAGS = -std=c11 -D_DEFAULT_SOURCE -D_GNU_SOURCE -Wall -Wextra -Werror $(CFLAGS) $(SANITIZE)
GRAMMARS = java python javascript typescript tsx go xml
CORE = security/capabilities.c security/facts.c security/query.c src/foundation/sha256.c src/foundation/secure_random.c
SOURCES = security/main.c security/parser.c security/models.c security/java_models.c
HEADERS = security/java_models.h security/agent_views.h security/capabilities.h security/facts.h security/parser.h security/operation.h security/flow.h security/local_flow.h src/foundation/sha256.h src/foundation/secure_random.h
VENDOR_ROOTS = internal/cbm/vendored/ts_runtime internal/cbm/vendored/common $(addprefix internal/cbm/vendored/grammars/,$(GRAMMARS))
VENDOR_DEPS = $(shell find $(VENDOR_ROOTS) -type f)
OBJECTS = $(BUILD)/runtime.o $(addprefix $(BUILD)/grammar-,$(addsuffix .o,$(GRAMMARS)))
LDLIBS += -lm
ifeq ($(OS),Windows_NT)
LDLIBS += -lbcrypt
endif

.PHONY: all test test-core clean FORCE
all: $(BUILD)/cbm-security-facts $(BUILD)/cbm-security-mcp

# Compiler flags are part of the stamp so changing sanitizer/optimization flags
# in the same build directory cannot silently reuse differently built objects.
$(BUILD)/flags: FORCE
	@mkdir -p $(BUILD)
	@printf '%s\n' '$(CC) $(CPPFLAGS) $(SEC_FLAGS) $(LDLIBS)' > $@.tmp
	@cmp -s $@.tmp $@ || cp $@.tmp $@
	@rm -f $@.tmp

$(BUILD)/identity.h: FORCE
	@mkdir -p $(BUILD)
	@$(PYTHON) security/build_id.py > $(BUILD)/identity.sha.tmp
	@printf '#define SF_BUILD_ID "%s"\n' "$$(cat $(BUILD)/identity.sha.tmp)" > $@.tmp
	@cmp -s $@.tmp $@ || cp $@.tmp $@
	@rm -f $@.tmp $(BUILD)/identity.sha.tmp

$(BUILD)/runtime.o: internal/cbm/ts_runtime.c $(VENDOR_DEPS) $(BUILD)/flags
	$(CC) $(CPPFLAGS) -std=c11 -D_DEFAULT_SOURCE -D_GNU_SOURCE $(CFLAGS) $(SANITIZE) -c $< -o $@

$(BUILD)/grammar-%.o: internal/cbm/grammar_%.c $(VENDOR_DEPS) $(BUILD)/flags
	$(CC) $(CPPFLAGS) -std=c11 $(CFLAGS) $(SANITIZE) -c $< -o $@

$(BUILD)/yyjson.o: vendored/yyjson/yyjson.c vendored/yyjson/yyjson.h $(BUILD)/flags
	$(CC) $(CPPFLAGS) -std=c11 $(CFLAGS) $(SANITIZE) -c $< -o $@

$(BUILD)/cbm-security-facts: $(SOURCES) $(CORE) $(HEADERS) $(BUILD)/identity.h $(BUILD)/flags $(OBJECTS)
	$(CC) $(CPPFLAGS) $(SEC_FLAGS) -include $(BUILD)/identity.h $(SOURCES) $(CORE) $(OBJECTS) $(LDLIBS) -o $@

$(BUILD)/cbm-security-mcp: security/mcp.c security/agent_views.c security/operation.c security/flow.c security/local_flow.c security/parser.c security/models.c security/java_models.c $(CORE) $(HEADERS) vendored/yyjson/yyjson.h $(BUILD)/identity.h $(BUILD)/flags $(OBJECTS) $(BUILD)/yyjson.o
	$(CC) $(CPPFLAGS) $(SEC_FLAGS) -include $(BUILD)/identity.h security/mcp.c security/agent_views.c security/operation.c security/flow.c security/local_flow.c security/parser.c security/models.c security/java_models.c $(CORE) $(OBJECTS) $(BUILD)/yyjson.o $(LDLIBS) -o $@

$(BUILD)/test-core: tests/security/test_core.c $(CORE) $(HEADERS) $(BUILD)/flags
	$(CC) $(CPPFLAGS) $(SEC_FLAGS) tests/security/test_core.c $(CORE) $(LDLIBS) -o $@

test-core: $(BUILD)/test-core
	$(BUILD)/test-core

test: all test-core
	@for test in tests/security/test_*.py; do \
	  echo "Running $$test"; \
	  $(PYTHON) "$$test" $(BUILD)/cbm-security-facts || exit $$?; \
	done

clean:
	rm -f $(BUILD)/cbm-security-facts $(BUILD)/cbm-security-mcp $(BUILD)/yyjson.o $(BUILD)/test-core $(OBJECTS) $(BUILD)/identity.h $(BUILD)/flags
